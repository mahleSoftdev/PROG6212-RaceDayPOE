<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RaceDayPOE.Web</RootNamespace>
    <AssemblyName>RaceDayPOE.Web</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Deliberately no EF Core / SQL / Azure packages: all data and file handling goes through the RaceDay API. -->

</Project>
