@model LoginViewModel
@using RaceDayPOE.Web.Models.Api
@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}
<h1 class="rd-title mb-1">Welcome back</h1>
<p class="text-muted mb-4">Log in to enrol in events, track your results or manage your races.</p>

@if (ViewData["Notice"] is string notice)
{
    <div class="alert alert-info" role="status">@notice</div>
}

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <fieldset class="mb-3">
        <legend class="form-label">I am a</legend>
        <div class="role-switch">
            <input type="radio" class="btn-check" asp-for="Role" id="role-participant" value="@AccountRole.Participant" />
            <label class="role-option" for="role-participant"><i class="bi bi-person-walking"></i> Participant</label>
            <input type="radio" class="btn-check" asp-for="Role" id="role-organiser" value="@AccountRole.Organiser" />
            <label class="role-option" for="role-organiser"><i class="bi bi-flag-fill"></i> Organiser</label>
        </div>
    </fieldset>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email address</label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Password" class="form-label">Password</label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Log in</button>
</form>

<p class="text-center text-muted mt-4 mb-0">New to RaceDay? <a asp-action="Register">Create a participant account</a></p>
<p class="small text-center text-muted mt-2 mb-0">Organiser accounts are provisioned by the RaceDay team.</p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
