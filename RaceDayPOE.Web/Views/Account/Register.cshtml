@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = "_AuthLayout";
}
<h1 class="rd-title mb-1">Join RaceDay</h1>
<p class="text-muted mb-4">Create a participant account to enrol in runs, walks and rides.</p>

<form asp-action="Register" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-sm-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" autofocus />
            <span asp-validation-for="FirstName" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-12">
            <label asp-for="Email" class="form-label">Email address</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <div class="form-text">At least 8 characters.</div>
            <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="invalid-feedback d-block"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">Create account</button>
</form>
<p class="text-center text-muted mt-4 mb-0">Already registered? <a asp-action="Login">Log in</a></p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
