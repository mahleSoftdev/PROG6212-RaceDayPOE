@{
    var code = ViewData["Code"] as int? ?? 404;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
}
<div class="rd-empty text-center mx-auto" style="max-width:36rem">
    <div class="rd-empty-icon"><i class="bi bi-@(code == 404 ? "compass" : "cone-striped")"></i></div>
    <h1 class="rd-title">@(code == 404 ? "Off the course" : "We hit a hurdle")</h1>
    <p class="text-muted">@(code switch
    {
        404 => "We couldn't find that page. The link may be old, or the event may have been removed.",
        403 => "You don't have access to that page.",
        _ => "Something went wrong. Please try again in a moment."
    })</p>
    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Back to events</a>
</div>
