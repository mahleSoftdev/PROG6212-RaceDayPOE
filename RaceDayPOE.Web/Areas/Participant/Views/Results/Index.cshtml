@model List<ResultDto>
@{ ViewData["Title"] = "My results"; }
<div class="page-head">
    <div><h1 class="rd-title">My results</h1><p class="text-muted mb-0">Your race history. Results appear once an organiser has recorded them.</p></div>
</div>

@if (Model.Count == 0)
{
    <div class="rd-card rd-empty text-center">
        <div class="rd-empty-icon"><i class="bi bi-trophy"></i></div>
        <h2 class="rd-h2">No results yet</h2>
        <p class="text-muted">After you've raced and the organiser publishes times, your history will show up here.</p>
        <a class="btn btn-primary" asp-area="Participant" asp-controller="Enrolments" asp-action="Index">View my enrolments</a>
    </div>
}
else
{
    <div class="rd-card table-responsive">
        <table class="table rd-table">
            <caption class="visually-hidden">Your race results</caption>
            <thead><tr><th scope="col">Event</th><th scope="col">Date</th><th scope="col">Category</th><th scope="col">Finish time</th><th scope="col">Position</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td class="fw-semibold">@r.EventName</td>
                    <td>@(r.EventDate is DateTime d ? Format.Date(d) : "-")</td>
                    <td>@(r.CategoryName ?? "-")</td>
                    <td class="time-cell">@Format.FinishTime(r.FinishTime)</td>
                    <td>
                        <span class="result-pos">@Format.Ordinal(r.Position)</span>
                        @if (r.TotalFinishers is int total && total > 0) { <span class="text-muted"> out of @total finishers</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
