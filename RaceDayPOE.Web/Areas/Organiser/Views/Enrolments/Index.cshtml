@model EnrolmentsPageViewModel
@{ ViewData["Title"] = "Enrolments"; }
<div class="page-head">
    <div><h1 class="rd-title">Enrolments</h1><p class="text-muted mb-0">Who is entered in your events, and in which category.</p></div>
</div>

@if (Model.Event is null)
{
    <h2 class="rd-h2">Choose an event</h2>
    <partial name="_EventPicker" model="Model.Events" view-data='new ViewDataDictionary(ViewData) { { "Action", "Index" } }' />
}
else
{
    <partial name="_EventHeader" model="Model.Event" />
    <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 align-items-end mb-3">
        <input type="hidden" name="eventId" value="@Model.Event.EventID" />
        <div><label for="status" class="form-label mb-1">Show</label>
            <select id="status" name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All statuses</option>
                @foreach (var s in Enum.GetValues<EnrolmentStatus>()) { <option value="@s" selected="@(Model.StatusFilter == s)">@s</option> }
            </select></div>
        <noscript><button class="btn btn-primary" type="submit">Filter</button></noscript>
        <span class="text-muted ms-auto">@Model.Enrolments.Count @(Model.Enrolments.Count == 1 ? "participant" : "participants")</span>
    </form>

    @if (Model.Enrolments.Count == 0)
    {
        <div class="rd-card rd-empty text-center"><div class="rd-empty-icon"><i class="bi bi-people"></i></div><h2 class="rd-h2">No enrolments to show</h2><p class="text-muted mb-0">Once participants enrol they'll appear here.</p></div>
    }
    else
    {
        <div class="rd-card table-responsive">
            <table class="table rd-table">
                <caption class="visually-hidden">Enrolments for @Model.Event.Name</caption>
                <thead><tr><th scope="col">Participant</th><th scope="col">Category</th><th scope="col">Enrolled on</th><th scope="col">Status</th><th scope="col">Change status</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td class="fw-semibold">@e.ParticipantName</td>
                        <td>@e.CategoryName</td>
                        <td>@Format.Date(e.EnrolmentDate)</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td>
                            <form asp-action="UpdateStatus" asp-route-eventId="@Model.Event.EventID" asp-route-id="@e.EnrolmentID" method="post" class="d-flex gap-2">
                                <label for="st-@e.EnrolmentID" class="visually-hidden">Status for @e.ParticipantName</label>
                                <select id="st-@e.EnrolmentID" name="status" class="form-select form-select-sm" style="max-width:9rem">
                                    @foreach (var s in Enum.GetValues<EnrolmentStatus>()) { <option value="@s" selected="@(e.Status == s)">@s</option> }
                                </select>
                                <button type="submit" class="btn btn-outline-primary btn-sm">Update</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
