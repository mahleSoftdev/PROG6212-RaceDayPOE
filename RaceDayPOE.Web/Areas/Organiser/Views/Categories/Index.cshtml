@model CategoriesPageViewModel
@{ ViewData["Title"] = "Categories"; var editing = Model.EditingCategoryId is not null; }
<div class="page-head">
    <div><h1 class="rd-title">Categories</h1><p class="text-muted mb-0">Add age or distance categories to an event.</p></div>
</div>

@if (Model.Event is null)
{
    <h2 class="rd-h2">Choose an event</h2>
    <partial name="_EventPicker" model="Model.Events" view-data='new ViewDataDictionary(ViewData) { { "Action", "Index" } }' />
}
else
{
    <partial name="_EventHeader" model="Model.Event" />
    <div class="row g-4">
        <div class="col-xl-7">
            <section class="rd-card" aria-labelledby="cat-h">
                <div class="rd-card-body pb-0"><h2 class="rd-h2" id="cat-h">Categories (@Model.Event.Categories.Count)</h2></div>
                @if (Model.Event.Categories.Count == 0)
                {
                    <p class="text-muted rd-card-body pt-0 mb-0">No categories yet. Participants can't enrol until you add one.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table rd-table">
                            <caption class="visually-hidden">Categories for @Model.Event.Name</caption>
                            <thead><tr><th scope="col">Name</th><th scope="col">Distance</th><th scope="col">Fee</th><th scope="col">Enrolled</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                            <tbody>
                            @foreach (var c in Model.Event.Categories.OrderBy(c => c.DistanceKm))
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td>@Format.Km(c.DistanceKm)</td>
                                    <td>@Format.Rand(c.EntryFee)</td>
                                    <td>@c.Enrolled / @c.MaxParticipants</td>
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-eventId="@Model.Event.EventID" asp-route-editId="@c.CategoryID">Edit</a>
                                        <form asp-action="Delete" asp-route-eventId="@Model.Event.EventID" asp-route-id="@c.CategoryID" method="post" class="d-inline" data-confirm="Delete category &quot;@c.Name&quot;?"><button type="submit" class="btn btn-outline-danger btn-sm">Delete</button></form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
        <div class="col-xl-5">
            <section class="rd-card rd-card-body" aria-labelledby="form-h">
                <h2 class="rd-h2" id="form-h">@(editing ? "Edit category" : "Add a category")</h2>
                <form asp-action="@(editing ? "Update" : "Create")" asp-route-eventId="@Model.Event.EventID" asp-route-id="@Model.EditingCategoryId" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-12"><label asp-for="Form.Name" class="form-label">Category name</label><input asp-for="Form.Name" class="form-control" placeholder="e.g. 10km Open or Under 20" /><span asp-validation-for="Form.Name" class="invalid-feedback d-block"></span></div>
                        <div class="col-sm-6"><label asp-for="Form.DistanceKm" class="form-label"></label><input asp-for="Form.DistanceKm" type="number" step="0.01" min="0.01" class="form-control" /><span asp-validation-for="Form.DistanceKm" class="invalid-feedback d-block"></span></div>
                        <div class="col-sm-6"><label asp-for="Form.EntryFee" class="form-label"></label><input asp-for="Form.EntryFee" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="Form.EntryFee" class="invalid-feedback d-block"></span></div>
                        <div class="col-12"><label asp-for="Form.MaxParticipants" class="form-label"></label><input asp-for="Form.MaxParticipants" type="number" min="1" class="form-control" /><span asp-validation-for="Form.MaxParticipants" class="invalid-feedback d-block"></span></div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">@(editing ? "Save category" : "Add category")</button>
                        @if (editing) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-eventId="@Model.Event.EventID">Cancel</a> }
                    </div>
                </form>
            </section>
        </div>
    </div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
