@model EventFormViewModel
@{ ViewData["Title"] = Model.IsEdit ? "Edit event" : "New event"; }
<div class="page-head">
    <div><h1 class="rd-title">@(Model.IsEdit ? "Edit event" : "New event")</h1><p class="text-muted mb-0">@(Model.IsEdit ? "Update the details participants see." : "Tell participants what, when and where.")</p></div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to events</a>
</div>

@if (Model.Venues.Count == 0)
{
    <div class="alert alert-warning">You need a venue before you can create an event. <a asp-controller="Venues" asp-action="Create">Add a venue</a> first.</div>
}

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-4">
        <div class="col-lg-8">
            <section class="rd-card rd-card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label">Event name</label>
                        <input asp-for="Name" class="form-control" maxlength="150" />
                        <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" maxlength="500" data-counter="#desc-count"></textarea>
                        <div class="form-text"><span id="desc-count">0</span> / 500 characters</div>
                        <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="date" class="form-control" />
                        <span asp-validation-for="EventDate" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select" asp-items="@(Html.GetEnumSelectList<EventType>())"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="VenueID" class="form-label"></label>
                        <select asp-for="VenueID" class="form-select">
                            <option value="0">Choose a venue...</option>
                            @foreach (var v in Model.Venues)
                            {
                                <option value="@v.VenueID" selected="@(v.VenueID == Model.VenueID)">@v.Name, @v.City</option>
                            }
                        </select>
                        <span asp-validation-for="VenueID" class="invalid-feedback d-block"></span>
                    </div>
                </div>
            </section>

            @if (!Model.IsEdit)
            {
                <section class="rd-card rd-card-body mt-4">
                    <h2 class="rd-h2">Main distance</h2>
                    <p class="text-muted small">This becomes the event's first category. Add more distances or age groups later on the Categories page.</p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="DistanceKm" class="form-label"></label>
                            <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="DistanceKm" class="invalid-feedback d-block"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EntryFee" class="form-label"></label>
                            <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="EntryFee" class="invalid-feedback d-block"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MaxParticipants" class="form-label"></label>
                            <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                            <span asp-validation-for="MaxParticipants" class="invalid-feedback d-block"></span>
                        </div>
                    </div>
                </section>
            }
        </div>

        <div class="col-lg-4">
            <section class="rd-card rd-card-body">
                <h2 class="rd-h2">Banner image</h2>
                <div class="preview-box mb-3 @(string.IsNullOrEmpty(Model.ExistingBannerUrl) ? "d-none" : "")">
                    <img id="banner-preview" src="@Model.ExistingBannerUrl" alt="Current event banner" class="img-fluid" />
                </div>
                <label asp-for="Banner" class="visually-hidden"></label>
                <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" data-preview="#banner-preview" />
                <div class="form-text">JPG, PNG, GIF or WebP, up to 5 MB. @(Model.IsEdit ? "Leave empty to keep the current banner." : "Optional, but events with a banner stand out.")</div>
            </section>
            <button type="submit" class="btn btn-primary btn-lg w-100 mt-4" disabled="@(Model.Venues.Count == 0)">@(Model.IsEdit ? "Save changes" : "Create event")</button>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
