@model VenueForm
@{ var edit = Model.VenueId is not null; ViewData["Title"] = edit ? "Edit venue" : "New venue"; }
<div class="page-head">
    <div><h1 class="rd-title">@(edit ? "Edit venue" : "New venue")</h1></div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to venues</a>
</div>
<form asp-action="@(edit ? "Edit" : "Create")" asp-route-id="@Model.VenueId" method="post" class="rd-card rd-card-body" novalidate style="max-width:760px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12"><label asp-for="Name" class="form-label">Venue name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="invalid-feedback d-block"></span></div>
        <div class="col-12"><label asp-for="AddressLine" class="form-label"></label><input asp-for="AddressLine" class="form-control" /><span asp-validation-for="AddressLine" class="invalid-feedback d-block"></span></div>
        <div class="col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="invalid-feedback d-block"></span></div>
        <div class="col-md-6"><label asp-for="Province" class="form-label"></label>
            <input asp-for="Province" class="form-control" list="provinces" />
            <datalist id="provinces"><option value="Eastern Cape" /><option value="Free State" /><option value="Gauteng" /><option value="KwaZulu-Natal" /><option value="Limpopo" /><option value="Mpumalanga" /><option value="Northern Cape" /><option value="North West" /><option value="Western Cape" /></datalist>
            <span asp-validation-for="Province" class="invalid-feedback d-block"></span></div>
        <div class="col-md-6"><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" type="number" step="0.000001" class="form-control" /><span asp-validation-for="Latitude" class="invalid-feedback d-block"></span></div>
        <div class="col-md-6"><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" type="number" step="0.000001" class="form-control" /><span asp-validation-for="Longitude" class="invalid-feedback d-block"></span></div>
        <div class="col-12 form-text">Tip: right-click a spot in Google Maps and click the coordinates to copy them.</div>
    </div>
    <button type="submit" class="btn btn-primary mt-4">@(edit ? "Save changes" : "Add venue")</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
