@model List<EventDto>
@{ var action = (string)ViewData["Action"]!; }
@if (Model.Count == 0)
{
    <div class="rd-card rd-empty text-center">
        <div class="rd-empty-icon"><i class="bi bi-calendar-plus"></i></div>
        <h2 class="rd-h2">Create an event first</h2>
        <p class="text-muted">This page works on one of your events, and you haven't created any yet.</p>
        <a class="btn btn-primary" asp-controller="Events" asp-action="Create">Create an event</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var e in Model)
        {
            <div class="col-md-6 col-xl-4">
                <a class="rd-card event-pick" asp-action="@action" asp-route-eventId="@e.EventID">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <partial name="_TypePill" model="e.EventType" />
                        <span class="status-badge @(e.IsUpcoming ? "status-upcoming" : "status-completed")">@(e.IsUpcoming ? "Upcoming" : "Completed")</span>
                    </div>
                    <div class="fw-bold fs-5">@e.Name</div>
                    <div class="text-muted small">@Format.Date(e.EventDate) &middot; @(e.Venue ?? "Venue TBC")</div>
                    <div class="small mt-2"><i class="bi bi-people"></i> @e.EnrolmentCount enrolled &middot; @e.Categories.Count categories</div>
                </a>
            </div>
        }
    </div>
}
