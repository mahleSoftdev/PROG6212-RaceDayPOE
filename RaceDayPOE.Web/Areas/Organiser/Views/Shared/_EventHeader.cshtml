@model EventDto
<div class="rd-card rd-card-body d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <partial name="_TypePill" model="Model.EventType" />
        <span class="status-badge @(Model.IsUpcoming ? "status-upcoming" : "status-completed") ms-1">@(Model.IsUpcoming ? "Upcoming" : "Completed")</span>
        <div class="fw-bold fs-4 mt-1">@Model.Name</div>
        <div class="text-muted"><i class="bi bi-calendar-event"></i> @Format.LongDate(Model.EventDate) &middot; <i class="bi bi-geo-alt"></i> @(Model.Venue ?? "Venue TBC")</div>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-eventId="">Change event</a>
</div>
